{
  "entities": {
    "HospitalSettings": {
      "title": "Hospital Settings",
      "description": "Hospital branding and settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameEn": { "type": "string" }
      },
      "required": ["id"]
    },
    "ClinicalRecord": {
      "title": "Clinical Record",
      "description": "A medical record document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" }
      },
      "required": ["id"]
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "A staff member in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id"]
    },
    "DailyAudit": {
      "title": "Daily Audit",
      "description": "An audit checklist.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id"]
    },
    "SystemLog": {
      "title": "System Log",
      "description": "A system IT log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["id"]
    },
    "Notification": {
        "title": "Notification",
        "description": "A user notification.",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "userId": { "type": "string" }
        },
        "required": ["id", "userId"]
    }
  },
  "firestore": {
    "/baheya_settings/{settingId}": {
      "schema": { "$ref": "HospitalSettings" },
      "description": "Hospital settings."
    },
    "/baheya_clinical_records/{recordId}": {
      "schema": { "$ref": "ClinicalRecord" },
      "description": "Clinical medical records."
    },
    "/baheya_staff_registry/{staffId}": {
      "schema": { "$ref": "StaffMember" },
      "description": "Staff registry."
    },
    "/baheya_daily_audits/{auditId}": {
      "schema": { "$ref": "DailyAudit" },
      "description": "Daily audits."
    },
    "/baheya_system_logs/{logId}": {
      "schema": { "$ref": "SystemLog" },
      "description": "System logs."
    },
    "/notifications/{notificationId}": {
        "schema": { "$ref": "Notification" },
        "description": "User notifications."
    }
  }
}
